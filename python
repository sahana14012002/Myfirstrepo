-- Select all columns from a table
SELECT * FROM employees;

-- Select specific columns and filter by condition (WHERE)
SELECT first_name, last_name, salary 
FROM employees 
WHERE salary > 70000;

-- Combine conditions (AND, OR, NOT) and sort results (ORDER BY)
SELECT first_name, last_name, salary 
FROM employees 
WHERE (dept_id = 1 OR salary >= 80000) AND hire_date >= '2022-01-01'
ORDER BY salary DESC;

-- Find text matching a pattern (LIKE) and specific sets (IN)
SELECT first_name, email 
FROM employees 
WHERE last_name LIKE 'S%' OR dept_id IN (1, 2);
